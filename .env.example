# Copy to .env and fill in. Never commit the real file.

# Nebius Token Factory key: https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Optional overrides. Defaults are the NVIDIA Nemotron models in copilot/config.py.
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# COPILOT_MODEL_TRIAGE=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# COPILOT_MODEL_REASON=nvidia/Nemotron-3-Ultra-550b-a55b
# COPILOT_MODEL_WRITER=nvidia/nemotron-3-super-120b-a12b

# Development on NVIDIA's own API (build.nvidia.com) instead of Token Factory.
# Uncomment all four, put the NVIDIA key (nvapi-...) in NEBIUS_API_KEY above,
# and comment them out again once the Token Factory key is in. The submitted
# app must call Token Factory. IDs checked against integrate.api.nvidia.com/v1/models.
# NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1
# COPILOT_MODEL_TRIAGE=nvidia/nemotron-nano-3-30b-a3b
# COPILOT_MODEL_REASON=nvidia/nemotron-3-ultra-550b-a55b
# COPILOT_MODEL_WRITER=nvidia/nemotron-3-super-120b-a12b

# Optional: enables the external-research step. https://tavily.com
TAVILY_API_KEY=
